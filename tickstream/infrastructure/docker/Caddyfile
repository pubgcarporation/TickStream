# API_ADDRESS is the API's domain (automatic HTTPS) or ":80" for plain HTTP on the server's IP address.
# Browser access rules (CORS) are handled by the API itself, using CORS_ORIGINS.
{$API_ADDRESS::80} {
	encode zstd gzip

	# Requests are shared between the API copies. A copy that stops answering is skipped until it recovers.
	reverse_proxy api:3001 api2:3001 {
		lb_policy least_conn
		health_uri /health/ready
		health_interval 10s
		flush_interval -1
	}

	header {
		X-Content-Type-Options nosniff
	}
}
