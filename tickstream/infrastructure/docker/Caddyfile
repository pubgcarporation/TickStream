# SITE_ADDRESS is the site's domain (automatic HTTPS) or ":80" for plain HTTP on the server's IP address.
# The website and the API share one address: /api goes to the API, everything else is the website.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	handle /health/* {
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
	}
}
