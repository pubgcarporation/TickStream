{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "stack": "bun run ./tickstream/infrastructure/scripts/dev.ts",
    "stack:up": "docker compose -f tickstream/infrastructure/docker/docker-compose.yml up -d --wait",
    "api": "bun run ./tickstream/apps/api/src/server.ts",
    "worker:media": "bun run ./tickstream/apps/media-worker/src/index.ts",
    "worker:settlement": "bun run ./tickstream/apps/settlement-worker/src/index.ts",
    "seed": "bun run ./tickstream/infrastructure/scripts/seed-demo.ts",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src scripts --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "test:api": "bun test tickstream/tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@circle-fin/adapter-viem-v2": "^1.19.2",
    "@circle-fin/app-kit": "^1.18.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@circle-fin/x402-batching": "^4.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "@privy-io/react-auth": "^3.52.0",
    "@privy-io/wagmi": "^4.0.20",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "@x402/core": "^2.32.0",
    "@x402/evm": "^2.32.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^11.15.0",
    "hls.js": "^1.7.4",
    "ioredis": "^6.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "6.4.6",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}
