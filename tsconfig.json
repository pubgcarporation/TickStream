{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./tickstream/packages/shared/src/*"],
      "viem/_types/*": ["./node_modules/viem/_types/*"],
      "/home/runner/_work/stablecoin-kits-private/stablecoin-kits-private/node_modules/viem/_types/accounts/index.d.ts": [
        "./node_modules/viem/_types/accounts/index.d.ts"
      ],
      "/home/runner/_work/stablecoin-kits-private/stablecoin-kits-private/node_modules/zod/dist/types/index.d.ts": [
        "./node_modules/@circle-fin/app-kit/node_modules/zod/dist/types/index.d.ts",
        "./node_modules/zod/dist/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "tickstream/apps/api/src",
    "tickstream/apps/media-worker/src",
    "tickstream/apps/settlement-worker/src",
    "tickstream/packages/shared/src",
    "tickstream/packages/payment-sdk/src",
    "tickstream/packages/arc-sdk/src",
    "tickstream/infrastructure/scripts"
  ]
}

